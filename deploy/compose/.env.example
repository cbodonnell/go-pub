# Copy this file to .env and adjust values before running docker compose

# Expose the app on this host:port (default: 127.0.0.1:8080)
HOST=127.0.0.1
PORT=8080

# ActivityPub server identity
# Include port if not 80/443 — used to build AP object IRIs
SERVER_NAME=localhost:8080
PROTOCOL=http

# Database credentials
DB_NAME=gopub
DB_USER=gopub
DB_PASSWORD=changeme

# Redis (leave blank for no password)
REDIS_PASSWORD=

# JWT signing secret — CHANGE THIS in production
JWT_KEY=changeme-set-a-real-secret

# Allow user registration (true/false)
REGISTER=true

# CORS allowed origins (comma-separated, empty = same-origin only)
ALLOWED_ORIGINS=
